{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec.openapis.org/oas/3.1/schema/2022-10-07",
  "title": "Pinned Local OpenAPI 3.1 Meta-Schema Subset",
  "type": "object",
  "required": ["openapi", "info", "paths"],
  "additionalProperties": false,
  "properties": {
    "openapi": {
      "type": "string",
      "pattern": "^3\\.1\\.\\d+$"
    },
    "info": {
      "$ref": "#/$defs/info"
    },
    "paths": {
      "$ref": "#/$defs/paths"
    },
    "components": {
      "$ref": "#/$defs/components"
    },
    "tags": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/tag"
      }
    }
  },
  "$defs": {
    "info": {
      "type": "object",
      "required": ["title", "version"],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "license": {
          "type": "object",
          "required": ["name"],
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "identifier": {
              "type": "string",
              "minLength": 1
            },
            "url": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "tag": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "paths": {
      "type": "object",
      "minProperties": 1,
      "patternProperties": {
        "^/api/v1/": {
          "$ref": "#/$defs/pathItem"
        }
      },
      "additionalProperties": false
    },
    "pathItem": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "get": { "$ref": "#/$defs/operation" },
        "post": { "$ref": "#/$defs/operation" },
        "put": { "$ref": "#/$defs/operation" },
        "patch": { "$ref": "#/$defs/operation" },
        "delete": { "$ref": "#/$defs/operation" }
      }
    },
    "operation": {
      "type": "object",
      "required": ["operationId", "responses"],
      "additionalProperties": false,
      "properties": {
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "operationId": {
          "type": "string",
          "minLength": 1
        },
        "responses": {
          "$ref": "#/$defs/responses"
        }
      }
    },
    "responses": {
      "type": "object",
      "minProperties": 1,
      "patternProperties": {
        "^[1-5][0-9][0-9]$": {
          "$ref": "#/$defs/response"
        }
      },
      "additionalProperties": false
    },
    "response": {
      "type": "object",
      "required": ["description"],
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1
        },
        "content": {
          "type": "object",
          "minProperties": 1,
          "patternProperties": {
            "^[a-z0-9.+-]+/[a-z0-9.+-]+$": {
              "$ref": "#/$defs/mediaType"
            }
          },
          "additionalProperties": false
        }
      }
    },
    "mediaType": {
      "type": "object",
      "required": ["schema"],
      "additionalProperties": false,
      "properties": {
        "schema": {
          "$ref": "#/$defs/schemaOrRef"
        }
      }
    },
    "components": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemas": {
          "type": "object",
          "minProperties": 1,
          "patternProperties": {
            "^[A-Za-z0-9_.-]+$": {
              "$ref": "#/$defs/schemaOrRef"
            }
          },
          "additionalProperties": false
        }
      }
    },
    "schemaOrRef": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "$ref": {
          "type": "string",
          "pattern": "^#/components/schemas/[A-Za-z0-9_.-]+$"
        },
        "type": {
          "anyOf": [
            { "type": "string", "minLength": 1 },
            {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            }
          ]
        },
        "format": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "enum": { "type": "array", "minItems": 1 },
        "minimum": { "type": "number" },
        "maximum": { "type": "number" },
        "required": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "properties": {
          "type": "object",
          "patternProperties": {
            "^.+$": { "$ref": "#/$defs/schemaOrRef" }
          },
          "additionalProperties": false
        },
        "items": { "$ref": "#/$defs/schemaOrRef" },
        "additionalProperties": {
          "anyOf": [
            { "type": "boolean" },
            { "$ref": "#/$defs/schemaOrRef" }
          ]
        }
      }
    }
  }
}
